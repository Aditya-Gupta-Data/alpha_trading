# Python
__pycache__/
*.pyc

# Secrets (Gmail app password, Gemini/Discord keys, broker keys, etc.)
# Blocks any .env variant (.env, .env.save, .env.local, ...) except the
# committed template, which only has placeholder values.
.env*
!.env.example

# Virtual environments
venv/
.venv/

# OS junk
.DS_Store
Thumbs.db

# Scheduler run logs
logs/

# Paper-trading state (portfolio, journal, news sentiment, brain map/weights
# are personal runtime data, not source code)
data/

# Trade-book audit export (scripts/export_trade_book.py) — a regenerable
# flattening of the personal journal, same class of data as data/
trade_book_audit.csv

# Claude Code's local, machine-specific settings -- not part of the app
.claude/

# Stage-A drop folder — regenerable CSVs the fetch script writes for the
# index_history clerk to ingest; the merged lake (also gitignored) is the
# artifact, not these throwaway inputs.
drop/

# Lovable React frontend — co-located here for local dev convenience, but
# version-controlled ONLY on the `lovable-ui` branch (decoupled branch
# strategy). It must never be committed to `main`, so `main` ignores it
# entirely. See DATA_CONTRACT.md "Branch strategy".
lovable-frontend/
# The current Lovable app (TanStack Start terminal UI) lives here. Same rule:
# framework code never pollutes the Python engine on `main`.
Trading Terminal/
archive/

# Python test-coverage artifacts (generated by coverage.py / pytest)
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/

# Live trade book (src/reporting/markdown_ledger.py, cron #32) — a regenerable
# render of the personal journal, written on the VM and pulled to the Mac;
# same class of data as data/ and trade_book_audit.csv
docs/LIVE_TRADE_BOOK.md
docs/LIVE_TRADE_BOOK.md.tmp
docs/LIVE_TRADE_BOOK.md.pulling
data/vm_mirror/
